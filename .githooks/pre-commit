#!/bin/sh
# Git pre-commit hook to verify formatting, vet, secret leaks, and run tests

set -e

echo "Running pre-commit checks..."

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

echo "==> Checking for leaked secrets with Trivy..."
if command -v trivy >/dev/null 2>&1; then
    trivy fs --scanners secret --exit-code 1 .
else
    echo "Warning: Trivy not found. Skipping secret scan."
fi

cd "$REPO_ROOT/src"

echo "==> Checking Go formatting..."
UNFORMATTED=$(gofmt -l .)
if [ -n "$UNFORMATTED" ]; then
    echo "ERROR: The following files need formatting with gofmt:"
    echo "$UNFORMATTED"
    echo "Run 'task fmt' or 'gofmt -w .' to fix."
    exit 1
fi

echo "==> Running go vet..."
go vet ./...

echo "==> Running unit tests..."
go test -v ./...

echo "All pre-commit checks passed!"
